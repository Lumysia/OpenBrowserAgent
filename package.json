{
  "name": "open-browser-agent",
  "version": "0.2.0-beta.21",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:safari": "wxt -b safari",
    "build": "npm run build:safari && npm run build:firefox && npm run build:chrome",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "local-execution-bridge": "node packages/local-execution-bridge/bin/cli.mjs run",
    "install-local-execution-bridge": "node packages/local-execution-bridge/bin/cli.mjs install",
    "update-local-execution-bridge": "node packages/local-execution-bridge/bin/cli.mjs update",
    "uninstall-local-execution-bridge": "node packages/local-execution-bridge/bin/cli.mjs uninstall",
    "zip": "node scripts/zip-with-hash.mjs",
    "compile": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:sync:webdav": "node --import tsx tests/sync-two-devices.ts",
    "test:browser": "node --import tsx --test tests/browser-smoke.test.mjs",
    "test:browser:pi": "node --import tsx --test tests/browser-pi.test.mjs",
    "test:browser:tools": "node --import tsx --test tests/browser-tool-*.test.mjs",
    "test:browser:mcp-origin": "node --import tsx tests/browser-mcp-origin-live.mjs",
    "test:page-translate:live": "node --import tsx scripts/page-translate-live-check.ts",
    "test:browser:all": "node --import tsx --test tests/browser-*.test.mjs",
    "eval": "node --import tsx eval/run.mjs",
    "store:screenshots": "node --import tsx scripts/store-screenshots.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@jitl/quickjs-ng-wasmfile-release-sync": "0.32.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "katex": "0.19.0",
    "lucide-react": "^1.56.0",
    "marked": "18.1.1",
    "marked-cjk-friendly": "0.1.2",
    "marked-footnote": "1.4.0",
    "marked-katex-extension": "5.1.13",
    "mermaid": "12.2.0",
    "nanoid": "^6.0.2",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remend": "1.4.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "linkedom": "^0.18.13",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "fx-runner": {
      "shell-quote": "^1.12.0"
    }
  }
}
